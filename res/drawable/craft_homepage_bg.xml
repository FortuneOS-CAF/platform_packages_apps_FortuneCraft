<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1f000000">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners
                android:topRightRadius="@dimen/craft_card_radius"
                android:topLeftRadius="@dimen/craft_card_radius"
                android:bottomLeftRadius="@dimen/craft_card_radius"
                android:bottomRightRadius="@dimen/craft_card_radius" />
        </shape>
    </item>
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/craft_card_color" />
            <corners
                android:topRightRadius="@dimen/craft_card_radius"
                android:topLeftRadius="@dimen/craft_card_radius"
                android:bottomLeftRadius="@dimen/craft_card_radius"
                android:bottomRightRadius="@dimen/craft_card_radius" />
        </shape>
    </item>
</ripple>
